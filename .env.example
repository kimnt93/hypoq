# Copy to .env (git-ignored) and edit.  `make` and `docker compose` read .env automatically;
# for a plain shell run:  set -a; source .env; set +a
# Every variable is optional: the defaults work for a local SQLite checkout.

# --- Database (hypoq package) -------------------------------------------------------------
# SQLite file used when DATABASE_URL is empty.
HYPOQ_DB=hypoq.db
# Set to use PostgreSQL instead of SQLite (docker compose service `postgres` from `make install-pg`).
# DATABASE_URL=postgresql://hypoq:hypoq_secret@127.0.0.1:5432/hypoq
POSTGRES_USER=hypoq
POSTGRES_PASSWORD=hypoq_secret
POSTGRES_DB=hypoq
POSTGRES_PORT=5432

# --- Embeddings for the hypothesis dedup search -------------------------------------------
# hf (default, local MiniLM, no key) or gemini.
# After changing any embedding setting run `make db-migrate` to re-embed the stored hypotheses.
EMBEDDING_PROVIDER=hf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only for EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=
# Optional: removes the Hugging Face "unauthenticated requests" warning
# HF_TOKEN=

# --- API / dashboard ----------------------------------------------------------------------
# use 0.0.0.0 only inside a trusted network or container
HYPOQ_HOST=127.0.0.1
# Next.js dashboard port (docker compose)
PORT=3030

# --- Paper build --------------------------------------------------------------------------
# Path of the Tectonic binary when it is not on PATH
# TECTONIC_BIN=/home/you/.local/bin/tectonic

# --- Data ingestion (scripts/, `make download`) -------------------------------------------
# SEC EDGAR fair-access policy requires a real contact address in the User-Agent. Use your own.
HYPOQ_CONTACT=you@example.com
# Optional local snapshots of sources without a free API (see DATA.md section 1.2)
# HYPOQ_VN_STRUCTURE_DIR=/path/to/vn_market_structure
# HYPOQ_WIDATA_JSON=/path/to/widata_cleaned_macro_series.json

# --- Agent CLIs launched by `python run.py --execute` ------------------------------------
# Override the command template of one agent ({prompt_file} and {root} are substituted).
# HYPOQ_AGENT_CMD_CLAUDE=claude -p "$(cat {prompt_file})" --permission-mode acceptEdits
